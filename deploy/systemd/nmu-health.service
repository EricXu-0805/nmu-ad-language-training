[Unit]
Description=NMU public endpoint health probe (the only check that runs from outside)
OnFailure=nmu-alert@%N.service
After=network-online.target

[Service]
Type=oneshot
# 本机的每一样东西都可能在服务已经不服务时继续报绿：备份脚本直接 sqlite3 打开磁盘上
# 的 app.db，服务死没死它照写 ok；health.state 只看备份链。这一条从**应用进程外面**
# 打一次公网地址，覆盖「进程活着但返 500」「Caddy 死了」「证书过期」「磁盘满转只读」。
# ⚠️ 它仍然跑在同一台机器上——解析到本机公网 IP、走本机网卡，所以「机房到互联网
# 那一跳断了」它探不出来；那一档只有异地那台 Mac 能发现。
# --max-time 挡住卡死的连接；-f 让 4xx/5xx 变成非零退出。
ExecStart=/usr/bin/curl -fsS --max-time 10 -o /dev/null https://89-208-253-119.sslip.io/health
Nice=10

[Install]
WantedBy=multi-user.target
