[Unit]
Description=NMU OS security backlog check (writes /opt/nmu/backups/os-security.state + dpkg inventory)
OnFailure=nmu-alert@%N.service

[Service]
Type=oneshot
# 只用标准库,系统 python3 足够。--json 的输出整份落 state 文件:
# 判定口径与 preflight --os 完全同一份代码,这里只是把它变成每周留档。
# `|| true` 曾经让退出码恒 0，于是上面那行 OnFailure 从来没响过——积压攒到 106 个
# 那次就是这么攒起来的。现在保留退出码：积压 > 0 时脚本退 1，单元进 failed 并告警。
# chmod 从 ExecStartPost 挪进来：失败时 ExecStartPost 不执行，state 文件权限会松。
ExecStart=/bin/sh -c '/usr/bin/python3 /opt/nmu/app/scripts/os_security_check.py \
    --json --inventory /opt/nmu/backups/os-packages.txt \
    > /opt/nmu/backups/os-security.state 2>&1; rc=$?; \
    chmod 600 /opt/nmu/backups/os-security.state /opt/nmu/backups/os-packages.txt; \
    exit $rc'
Nice=10
