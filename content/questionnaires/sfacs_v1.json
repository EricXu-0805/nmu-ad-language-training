  "sections": [
    {
      "section_id": "social",
      "title": "一、简单社交沟通",
      "items": [
        { "item_key": "sfacs_01", "no": 1, "text": "患者可以叫出认识的人的名字（例如：家人、朋友、同事）" },
        { "item_key": "sfacs_02", "no": 2, "text": "患者可以问简单的问题（例如：你住在哪里？）" },
        { "item_key": "sfacs_03", "no": 3, "text": "患者可以说明进行一件事情的步骤（例如：泡茶、设定闹钟）" },
        { "item_key": "sfacs_04", "no": 4, "text": "患者可以表示赞成或反对（例如：点头、说“好”）" },
        { "item_key": "sfacs_05", "no": 5, "text": "患者可以利用电话进行交谈（例如：回答问题、提供资料）" },
        { "item_key": "sfacs_06", "no": 6, "text": "患者可以参与小组谈话（例如：与家人吃饭时）" },
        { "item_key": "sfacs_07", "no": 7, "text": "患者可以遵循简单的口头指示（例如：请站起来或举手）" },
        { "item_key": "sfacs_08", "no": 8, "text": "患者可以了解别人话中的含义（例如：“已经很晚了”，暗示该回 去了）" },
        { "item_key": "sfacs_09", "no": 9, "text": "患者可以听懂电视或收音机所播放的内容（例如：新闻报导、电视 剧集）" },
        { "item_key": "sfacs_10", "no": 10, "text": "患者可以理解非口语的行为（例如：脸部表情、加强语气）" },
        { "item_key": "sfacs_11", "no": 11, "text": "患者可以主动与别人沟通" },
        { "item_key": "sfacs_12", "no": 12, "text": "患者可以在谈话间适时地加入新话题" },
        { "item_key": "sfacs_13", "no": 13, "text": "患者在对方改变谈话内容时，能配合及适应" },
        { "item_key": "sfacs_14", "no": 14, "text": "患者可以觉察对话中的错误并纠正（例如：叫错名字或说错时间、 地点）" }
      ]
    },
    {
      "section_id": "needs",
      "title": "二、表达需要",
      "items": [
        { "item_key": "sfacs_15", "no": 15, "text": "患者可以辨认熟悉的面孔" },
        { "item_key": "sfacs_16", "no": 16, "text": "患者可以辨认熟悉声音" },
        { "item_key": "sfacs_17", "no": 17, "text": "患者可以表达自己的喜恶（例如：人物、地方、食物）" },
        { "item_key": "sfacs_18", "no": 18, "text": "患者可以表达感受（例如：关心、伤心）" },
        { "item_key": "sfacs_19", "no": 19, "text": "患者可以请求别人帮忙（例如：掉了东西请人捡拾）" },
        { "item_key": "sfacs_20", "no": 20, "text": "患者可以表达基本需求（例如：想吃东西、休息）" },
        { "item_key": "sfacs_21", "no": 21, "text": "患者可以在紧急情况下作出适当的反应（例如：大声呻吟、呼救 或敲打）" }
      ]
    }
  ],
