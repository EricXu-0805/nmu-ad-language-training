# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略,绝不入库。
# 生成后 chmod 600 .env(仅 root 可读)。真正的密钥不要提交到仓库。

# ——— 不可变发布指针(生产 Compose 必填)———
# 必须是 registry/name@sha256:<64 位小写 hex>，不接受 latest/版本 tag 单独启动。
APP_IMAGE=YOUR.REGISTRY/nmu-platform@sha256:REPLACE_WITH_REVIEWED_64_HEX_DIGEST
# 三个卷都必须由具名运维员预建；Compose 只挂载，不自动新建/删除。
# 升级时 APPDATA_VOLUME 指向从已验证快照恢复的候选卷，原 live 卷保留。
APPDATA_VOLUME=nmu-platform-appdata-initial
CADDY_DATA_VOLUME=nmu-platform-caddydata
CADDY_CONFIG_VOLUME=nmu-platform-caddyconfig
# 默认从同一个私有 .env 向 app/migrate 注入运行配置；候选预演可用
# APP_ENV_FILE=.env.candidate 指向权限 0600 的候选副本。
APP_ENV_FILE=.env
# 只有与 docker-compose.host-caddy.yml 同用时才需要：候选 app 只绑回环，
# bridge IP 必须是现场测得的单个私网地址。容器入口拒绝空值、*、
# CIDR、列表、回环/公网地址，不要用占位值启动。
# APP_HOST_PORT=18000
# HOST_CADDY_BRIDGE_IP=172.28.0.1

# ——— 认证(公网必设)———
REQUIRE_AUTH=1
SESSION_COOKIE_SECURE=1
# 逗号分隔、只写准确主机名（不含 scheme/端口/通配符）。Docker 公网部署必填。
TRUSTED_HOSTS=YOUR.VPS.IP
# 床旁配对 PIN：console 主认证是账号登录，PIN 只用来签发短时、绑定单场次的老人端 capability。
# ★只要 REQUIRE_AUTH=1 或库里已有研究者账号就【必设】，同机双窗也不例外；
#   老人端故意不携带研究者 cookie，防止账号权限被静默升级。必须为 **8–32 位** ASCII 数字（2026-08-27 由 6 位提高）。
#   ⚠️ 换 PIN 会让**现有配对码全部作废**，要重新发给每位受试者。
#   ⚠️ 不合格的 PIN 会让应用**拒绝启动**——升级代码前先改这一行。
#   给老人端用的那个派生配对码仍是 6 位（护理员当面输），它的防线是全局限速器的
#   连续锁定阶梯（30s→2min→10min→1h），稳态尝试量因此降到约 64 次/小时。
# CONSOLE_PIN=

# ——— 反代站点地址(Caddy 读)———
# 有域名(推荐,自动证书):
# SITE_ADDRESS=training.example.com
# 仅 IP(暂无域名,配合 Caddyfile 里 tls internal):
SITE_ADDRESS=https://YOUR.VPS.IP

# ——— 数据边界（默认关闭）———
# 仅开发/合成数据环境可开启。开启后，前端可创建带 is_simulation=true 的场次；
# 它不会放宽真实研究场次的同意、语言、录音和撤回门禁。
# ALLOW_SIMULATION_DATA=1
# ⚠️ 真实入组前必须把 ALLOW_SIMULATION_DATA 关掉。开着它，界面上就存在建模拟场次的
# 入口，而模拟与真实场次落在同一张表里。生产 2026-08-27 仍开着（那台机器只有演示档）。
#
# 自动带练有两条互不放宽的通道：
#  ① P0a 模拟切片（下面这对旧双开关）——只认 simulation subject/session，
#     且只有精确绑定的 week2-single20-demo-v1 走得通。
# ENABLE_AUTOPILOT_P0A_SIMULATION=0
#  ② 真实研究场次通道——2026-08-21 起在产，覆盖第 2–8 周全部 7 周、每周 78 个计分题位。
#     前置：逐受试者云处理授权 + 云 provider readiness + 冻结的题库数据包。
#     协议话术仍是 draft 原型，未经书面双签。
# ENABLE_AUTOPILOT_REAL_SESSIONS=0
# 两条通道都不绕过 VisitPlan、完整协议、provider readiness、设备 capability
# 或正式研究守卫。

# ——— AI 质量看板隐私门槛（真实研究分区必设）———
# 只允许 2..100 的整数。缺失、空白、越界或含多余空格时，真实研究质量汇总
# 全部 fail-closed：不读取 attempt/转写/录音证据，不公开实际受试者数。
# 当前即使值有效，真实研究仍会因发布批次未冻结而整行抑制；该值是未来
# frozen cohort/release epoch + 逐单元互补抑制的必要条件，不是单独放行开关。
# 模拟质量查询另有服务端固定资源预算和独立限速；这些安全上限不从环境变量放宽。
# AI_QUALITY_RESEARCH_MIN_SUBJECTS=5

# ——— 去标识导出(启用导出时必设，缺失即 fail-closed)———
# 单独生成至少 32 bytes 的随机密钥；不得复用 PIN、账号密码或云 API Key。
# DEIDENTIFICATION_KEY=
# 非秘密的轮换标识，会写入版本化 HMAC token；仅允许字母/数字/._-。
# DEIDENTIFICATION_KEY_ID=nmu-2026-01

# ——— 云语音 / 转写 / 判分(可选增强；缺失时分别降级到本地 TTS、人工转写和受限规则判定)———
# TTS 红线:发往云 TTS 的文本只能是白名单闭集,永不携带患者字段(app/content.py 守卫)。
# 注意：云 ASR 仍会处理原始回答音频，云 LLM 会处理回答文本；详见 README/DEPLOY。
# DASHSCOPE_API_KEY=在此填,或用部署时注入(见 DEPLOY.md「密钥」);填了记得 chmod 600 .env
# 云 Key 配置时必设另一条独立随机秘密（至少 32 bytes，建议 openssl rand -base64 32），
# 只用于生成不可离线验证的凭据世代指纹；轮换任一秘密都会让旧服务检查立即失效。
# 不得有首尾空白或明显低熵，也不得复用 API Key、去标识密钥、PIN 或密码。
# PROVIDER_READINESS_FINGERPRINT_KEY=
# TTS_QWEN_VOICE=Serena              # 小语主音色（课题组耳测选择：苏瑶）
# TTS_CLOUD_RATE=0.9                 # 老人节奏语速,两个云引擎共用
# TTS_COSY_MODEL=cosyvoice-v2        # 备选龙媛在 v2;v3-plus 需工作空间单独开通
# TTS_COSY_VOICE=longyuan_v2

# ——— 失败限速(可留默认)———
# AUTH_FAIL_MAX=8
# AUTH_FAIL_WINDOW_SECONDS=300
# AUTH_LOCK_SECONDS=300
# 分布式换 IP 失败的进程级兜底；login 与 pair 分开计数，默认 64 次/300s
# 后短锁 30s。单 worker 之外必须改用共享限速器或前置代理限速。
# AUTH_GLOBAL_FAIL_MAX=64
# AUTH_GLOBAL_FAIL_WINDOW_SECONDS=300
# AUTH_GLOBAL_LOCK_SECONDS=30
# 失败/锁定唯一来源键 LRU 硬上限，防止换 IP 造成进程内存无界增长。
# AUTH_TRACKED_KEYS_MAX=4096
# 同时执行 PBKDF2 的全局上限；饱和请求统一认证失败，不查询用户名。
# AUTH_PBKDF2_MAX_CONCURRENCY=2

# ——— 数据库(默认 SQLite 于数据卷;小团队够用。要 Postgres 见 DEPLOY.md)———
# DATABASE_URL=sqlite:////app/data/app.db
# 音频原件目录（建议映射到独立加密数据卷；测试可指向临时目录）
# AUDIO_DIR=/app/data/audio
# 录音防失控配额（均为服务端硬门；同 raw_audio_id 的完全相同重放不重复计数）。
# 默认允许每环节 12 次、每场 512 条/8 GiB、单进程同时 4 条上传；单文件另固定 64 MiB。
# AUDIO_MAX_REGISTRATIONS_PER_TURN=12
# AUDIO_MAX_ASSETS_PER_SESSION=512
# AUDIO_MAX_BYTES_PER_SESSION=8589934592
# AUDIO_MAX_CONCURRENT_UPLOADS=4
# 非机密云数据处理 policy。两项都必须配置，且 provider id 必须与所选云引擎一致；
# 缺失或版本变化时，所有受试者云外呼均 fail-closed，须按新告知版本重新授权。
CLOUD_PROCESSING_PROVIDER_ID=aliyun-dashscope
CLOUD_PROCESSING_NOTICE_VERSION=
