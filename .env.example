# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略,绝不入库。
# 生成后 chmod 600 .env(仅 root 可读)。真正的密钥不要提交到仓库。

# ——— 认证(公网必设)———
REQUIRE_AUTH=1
SESSION_COOKIE_SECURE=1
# 共享 PIN:console 主认证是账号登录,PIN 给老人端平板用。
# ★双设备(老人端是独立平板)部署【必设】——否则平板无研究者 cookie,心跳/录音上传会一直 401、
#   前端弹 PIN 也无 PIN 可放行。同机双窗(console+patient 同一台)可不设。6+ 位数字。
# CONSOLE_PIN=

# ——— 反代站点地址(Caddy 读)———
# 有域名(推荐,自动证书):
# SITE_ADDRESS=training.example.com
# 仅 IP(暂无域名,配合 Caddyfile 里 tls internal):
SITE_ADDRESS=https://YOUR.VPS.IP

# ——— 云语音 / 转写 / 判分(可选增强;缺则全链降级本地/浏览器语音)———
# 红线:发往云 TTS 的文本只能是白名单闭集,永不携带患者字段(app/content.py 守卫)。
# DASHSCOPE_API_KEY=在此填,或用部署时注入(见 DEPLOY.md「密钥」);填了记得 chmod 600 .env
# TTS_COSY_MODEL=cosyvoice-v2        # 龙媛在 v2;v3-plus 需工作空间单独开通
# TTS_COSY_VOICE=longyuan_v2
# TTS_QWEN_VOICE=Serena
# TTS_CLOUD_RATE=0.9

# ——— 失败限速(可留默认)———
# AUTH_FAIL_MAX=8
# AUTH_FAIL_WINDOW_SECONDS=300
# AUTH_LOCK_SECONDS=300

# ——— 数据库(默认 SQLite 于数据卷;小团队够用。要 Postgres 见 DEPLOY.md)———
# DATABASE_URL=sqlite:////app/data/app.db
