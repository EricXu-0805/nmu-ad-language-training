# 反向代理 + TLS 终止。app 只在 compose 内网监听 8000,不对外。
# SITE_ADDRESS 由 .env 提供,两种模式:
#   有域名(推荐): SITE_ADDRESS=training.example.com     → 自动 Let's Encrypt 证书,保持 tls internal 注释
#   仅 IP(暂无域名): SITE_ADDRESS=https://203.0.113.10   → 取消下方 tls internal,用 Caddy 内部 CA 自签
# 老人端麦克风(getUserMedia)只在 https 安全上下文可用,故两种模式都必须走 TLS。
{$SITE_ADDRESS} {
	encode gzip
	# 完整答案定义与框架自带文档不属于浏览器发布面。这里作为应用层
	# fail-closed 授权之外的第二道边界，同时覆盖大小写和编码后的路径。
	@blocked_internal path_regexp blocked_internal (?i)^/(?:content/(?:item_bank_v1\.json|week1_script\.json|autopilot_protocol_v1\.json)|docs(?:/.*)?|redoc(?:/.*)?|openapi\.json)/?$
	respond @blocked_internal 404

	# 只有规范的录音 blob PUT 可以到 64 MiB；登录、配对和普通 JSON
	# 在 FastAPI 解析前统一压到 256 KiB。否则匿名者可并发发送接近
	# 64 MiB 的登录 JSON，让单 worker 在账号/PIN 限速命中前消耗内存与 CPU。
	@audio_blob_upload {
		method PUT
		path_regexp audio_blob_upload ^/audio/[A-Za-z0-9][A-Za-z0-9._-]{0,159}/blob$
	}
	@non_audio_blob_upload {
		not {
			method PUT
			path_regexp non_audio_blob_upload ^/audio/[A-Za-z0-9][A-Za-z0-9._-]{0,159}/blob$
		}
	}
	request_body @audio_blob_upload {
		max_size 64MB
	}
	request_body @non_audio_blob_upload {
		max_size 256KB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
	}
	# Caddy reverse_proxy 默认忽略客户端自带的 X-Forwarded-For，
	# 再依直连 peer 生成转发头；app 只信任本 Caddy 的固定内网 IP。
	# 若日后前置 CDN/反代，必须改用 Caddy 全局 trusted_proxies 精确信任该上游。
	reverse_proxy app:8000

	# 仅 IP 部署(无域名)时取消下一行注释:Caddy 用内部 CA 自签,浏览器首次访问需人工信任一次。
	# 有域名时保持注释——让 Caddy 走自动公共证书,无需任何手动信任。
	# tls internal
}
