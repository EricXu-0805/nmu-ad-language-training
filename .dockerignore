# 只把源码 + 冻结内容 + 迁移送进构建上下文;产物/依赖/数据/密钥全部排除。
.venv/
web/node_modules/
web/dist/
web/.vite/
web/public/content/
data/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.gstack/
.playwright-cli/
项目综合审计_*/
.git/
# Vite 会自动吸收 .env.production/.env.development 并可把 VITE_* 写入成品；
# 根目录和任意子目录的环境文件都不得进构建上下文。
.env
.env.*
*.env
*.env.*
**/.env*
!.env.example
!**/.env.example
# 本地/私有 registry 的 npm token 不得进任何构建层。
.npmrc
**/.npmrc
tests/
*.md
